# Copy to .env. Never commit real credentials.
MONGO_URI=mongodb://127.0.0.1:27017/clearcash
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
# Frontend origin only, without a trailing slash. Comma-separated origins are supported.
CORS_ORIGIN=http://localhost:5173
JWT_EXPIRES_IN=7d
# Optional demo credentials used only by npm run seed:
DEMO_EMAIL=demo@clearcash.example
DEMO_PASSWORD=ClearCashDemo123!
